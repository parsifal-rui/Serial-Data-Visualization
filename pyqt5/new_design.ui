&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe WPC','Segoe UI','sans-serif'; font-size:11pt; color:#000000;&quot;&gt;Speed feedback and control&lt;/span&gt;&lt;/p&gt;
